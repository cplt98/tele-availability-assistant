    {
      "id": "wfh-tmr",
      "text": "wfh tmr",
      "sender": "Alex",
      "today": "2026-10-07",
      "tags": ["update", "relative-date", "shorthand"],
      "expected": {
        "intent": "update",
        "entries": [{ "person": "Alex", "date": "2026-10-08", "status": "wfh" }]
      }
    },
    {
      "id": "office-next-wed",
