# Copy this file to .env and fill in your own values. Never commit .env.
# On a host, set these same names as environment variables instead and skip the file.

# From @BotFather on Telegram (message it, send /newbot)
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Free key from https://aistudio.google.com/apikey . Used to understand messages.
GEMINI_API_KEY=replace-with-your-gemini-key

# Optional: which Gemini model to use (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: turns on voice notes (speech to text) and spoken replies (text to speech).
# Create the key at https://elevenlabs.io . A key limited to Speech to Text and Text to Speech is enough.
# ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key
# The voice for spoken replies. On the free ElevenLabs plan this must be one of the built-in
# (premade) voices: the API refuses library voices on a free plan. Without it, replies stay text.
# ELEVENLABS_VOICE_ID=replace-with-a-voice-id
# Models (these are the defaults; any current ElevenLabs model ID works):
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional: the file listing who may use the bot (default: users.json).
# Copy users.example.json to users.json and put your own people and Telegram IDs in it.
# USERS_FILE=users.json

# Optional: a folder for what the bot writes (the database and the conversation log).
# Point it outside the project folder so private messages never sit next to the code.
# Relative paths start from the project folder. Default: the project folder.
# DATA_DIR=C:\Users\you\availability-data

# Optional: the database file name inside DATA_DIR (default: schedule.db)
# DB_PATH=schedule.db
